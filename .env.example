# Copy to .env and set POSTGRES_PASSWORD before starting.
POSTGRES_DB=damdam
POSTGRES_USER=damdam
POSTGRES_PASSWORD=

WEB_BIND_HOST=127.0.0.1
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000
# Set true when accessed through an HTTPS reverse proxy.
SESSION_COOKIE_SECURE=false

# Bootstrap the initial operator, or reset its password hash while preserving its ID (8-128 chars with a letter and a digit).
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=

# When running the API with Gradle outside Docker (these do not override Compose).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=damdam
DB_USER=damdam
DB_PASSWORD=
STORAGE_LEGACY_IMAGES_PATH=../web/public/images
# Optional instead of DB_*:
# DATABASE_URL=postgresql://damdam:password@localhost:5432/damdam
